# Central knobs used by build.sh. Edit values here rather than in the scripts.
# Manifests under argocd/ and apps/ are plain YAML (no templating) so Argo CD can
# read them straight from GitHub; this file only drives the bootstrap script.

# --- Argo CD control plane: the "deployer" cluster ---------------------------
ARGOCD_CONTEXT=kind-deployer
ARGOCD_NAMESPACE=argocd
ARGOCD_RELEASE=argocd
# Pulled over OCI, so no `helm repo add` and no repo-name collisions on the laptop.
ARGOCD_CHART=oci://ghcr.io/argoproj/argo-helm/argo-cd
ARGOCD_CHART_VERSION=10.9.6

# --- GitOps source of truth --------------------------------------------------
GIT_REPO=https://github.com/fakabbir/k8s-bootstrap.git
GIT_BRANCH=main

# --- Member clusters Argo CD drives -----------------------------------------
# Each entry is "kubectl-context|cluster-name|env-label|pinned-server-url".
#   cluster-name is what Argo CD and the ApplicationSets refer to the cluster by,
#   so renaming it here means renaming it in the ApplicationSets too.
#   Leave pinned-server-url empty to let build.sh discover a reachable API URL.
MANAGED_CLUSTERS=(
  "kind-dev|dev-cluster|development|"
  "orbstack|orbstack-prod|production|"
)

# RBAC granted to Argo CD inside every member cluster. The bundled
# argocd/clusters/manager-rbac.yaml binds argocd-manager to cluster-admin;
# point this at a narrower role once apps need fewer privileges.
ARGOCD_MANAGER_SA=argocd-manager
ARGOCD_MANAGER_NS=argocd

# Image used for the throwaway pod that tests whether the deployer cluster can
# actually reach each member API server before registering it. Must be pullable
# from the deployer cluster's nodes.
PROBE_IMAGE=curlimages/curl:8.14.1

# Upper bound for the Argo CD helm release and each of its components. A brand
# new kind cluster has to pull every Argo CD image on the first run, which is
# slow enough to look like a hang, so this is deliberately generous.
INSTALL_TIMEOUT=900

# Upper bound for argocd-root and the Applications it generates to report
# Synced/Healthy.
ROLLOUT_TIMEOUT=300
